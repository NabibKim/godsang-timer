# =====================================================================
# gt-proxy : 역방향 프록시 + timer 로드밸런서 (nginx)
# ---------------------------------------------------------------------
# 외부에 공개되는 유일한 컨테이너(80번 포트).
# 요청 경로를 보고 front / auth / timer(3대) / community 로 전달한다.
# =====================================================================
FROM nginx:1.28

ENV TZ=Asia/Seoul

# 기본 설정 파일을 갓생 타이머용 라우팅 설정으로 교체
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
