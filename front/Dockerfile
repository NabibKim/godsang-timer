# =====================================================================
# gt-front : 갓생 타이머 화면(HTML/CSS/JS) 정적 파일 서버 (nginx)
# ---------------------------------------------------------------------
# 빌드 과정 없는 순수 HTML + jQuery 프론트엔드.
# 데이터는 브라우저의 JS가 /api/... 로 직접 요청해서 화면에 채운다.
# =====================================================================
FROM nginx:1.28

ENV TZ=Asia/Seoul

# 화면 파일 전체를 nginx 기본 문서 폴더로 복사
COPY . /usr/share/nginx/html/

EXPOSE 80
